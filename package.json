{
  "name": "pillbox",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "20.20.0",
    "npm": "10.8.2"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 8082",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 8082",
    "format:check": "prettier --check .",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "app:version": "tsx scripts/print-app-version.ts",
    "medications:import": "tsx scripts/medications/import-bdpm-cli.ts",
    "medications:check-dates": "tsx scripts/medications/check-bdpm-dates-cli.ts",
    "medications:record-dates": "tsx scripts/medications/record-bdpm-source-dates-cli.ts",
    "build:android:check": "expo export --platform android --clear --output-dir dist",
    "android:release:validate-signing": "node ./scripts/android-signing.mjs --validate",
    "android:release:prebuild": "expo prebuild --platform android --no-install --clean",
    "android:release:prepare-signing": "node ./scripts/android-signing.mjs --write-keystore",
    "android:release:build": "./android/gradlew -p android app:assembleRelease --no-daemon",
    "android:release:verify": "node ./scripts/verify-android-apk.mjs"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "8.4.4",
    "expo": "~54.0.35",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "^0.32.17",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "~19.1.0",
    "better-sqlite3": "^11.10.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "prettier": "3.9.6",
    "tsx": "^4.23.10",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "jest-expo"
  }
}
