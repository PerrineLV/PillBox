{
  "name": "pillbox",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "20.20.0",
    "npm": "10.8.2"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 8082",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 8082",
    "format:check": "prettier --check .",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "EXPO_PUBLIC_USE_RN_FETCH=1 jest --runInBand",
    "app:version": "tsx scripts/print-app-version.ts",
    "medications:import": "tsx scripts/medications/import-bdpm-cli.ts",
    "medications:check-dates": "tsx scripts/medications/check-bdpm-dates-cli.ts",
    "medications:record-dates": "tsx scripts/medications/record-bdpm-source-dates-cli.ts",
    "build:android:check": "expo export --platform android --clear --output-dir dist",
    "android:release:validate-signing": "node ./scripts/android-signing.mjs --validate",
    "android:release:prebuild": "expo prebuild --platform android --no-install --clean",
    "android:release:prepare-signing": "node ./scripts/android-signing.mjs --write-keystore",
    "android:release:build": "./android/gradlew -p android app:assembleRelease --no-daemon",
    "android:release:verify": "node ./scripts/verify-android-apk.mjs"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "^57.0.0",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.10",
    "expo-local-authentication": "~57.0.3",
    "expo-mail-composer": "~57.0.2",
    "expo-notifications": "~57.0.18",
    "expo-router": "~57.0.21",
    "expo-sharing": "~57.0.19",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "~19.1.0",
    "better-sqlite3": "^11.10.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "3.9.6",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
