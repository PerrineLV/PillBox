{
  "name": "pillbox",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "20.20.0",
    "npm": "10.8.2"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "format:check": "prettier --check .",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "medications:import": "tsx scripts/medications/import-bdpm-cli.ts",
    "build:android:check": "expo export --platform android --clear --output-dir dist",
    "android:release:validate-signing": "node ./scripts/android-signing.mjs --validate",
    "android:release:prebuild": "expo prebuild --platform android --no-install --clean",
    "android:release:prepare-signing": "node ./scripts/android-signing.mjs --write-keystore",
    "android:release:build": "./android/gradlew -p android app:assembleRelease --no-daemon",
    "android:release:verify": "node ./scripts/verify-android-apk.mjs"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.11",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-linking": "~57.0.5",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "^57.0.9",
    "expo-router": "~57.0.11",
    "expo-sharing": "~57.0.10",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.8.1",
    "react-native-screens": "~4.27.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.18",
    "better-sqlite3": "^13.0.3",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.1",
    "jest": "^30.4.2",
    "jest-expo": "~57.0.3",
    "prettier": "3.9.6",
    "tsx": "^4.23.10",
    "typescript": "7.0.2"
  },
  "jest": {
    "preset": "jest-expo"
  }
}
