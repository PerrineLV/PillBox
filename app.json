{
  "expo": {
    "name": "PillBox",
    "slug": "pillbox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/pillbox-icon.png",
    "scheme": "pillbox",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.perrinelv.pillbox",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/pillbox-adaptive-icon.png",
        "backgroundColor": "#F4FAF7"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser PillBox à utiliser la caméra pour scanner un DataMatrix."
        }
      ],
      "./plugins/withAndroidReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
